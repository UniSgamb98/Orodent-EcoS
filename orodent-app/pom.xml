<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.orodent</groupId>
    <artifactId>orodent-ecos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>orodent-app</artifactId>
  <dependencies>
    <dependency><groupId>com.orodent</groupId><artifactId>orodent-core</artifactId></dependency>
    <dependency><groupId>com.orodent</groupId><artifactId>orodent-database</artifactId></dependency>
    <dependency><groupId>com.orodent</groupId><artifactId>orodent-ton</artifactId></dependency>
    <dependency><groupId>com.orodent</groupId><artifactId>orodent-statistiche</artifactId></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId>
    <configuration>
      <mainClass>com.orodent.ecos.app/com.orodent.ecos.app.MainApp</mainClass>
      <launcher>orodent-ecos</launcher>
      <jlinkImageName>orodent-ecos</jlinkImageName>
      <jlinkZipName>orodent-ecos</jlinkZipName>
      <noManPages>true</noManPages><stripDebug>true</stripDebug><noHeaderFiles>true</noHeaderFiles>
    </configuration>
  </plugin></plugins></build>
</project>
